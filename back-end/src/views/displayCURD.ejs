<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User List</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #f7f7f7;
        }

        table {
            width: 100%;
            margin-top: 20px;
            background: white;
            border-collapse: collapse;
        }

        thead tr {
            background: #eaeaea;
            border-bottom: 2px solid #333;
        }

        thead th {
            padding: 10px 0;
            font-weight: bold;
            text-align: center;
        }

        tbody tr {
            border-bottom: 1px solid #ddd;
        }

        tbody td {
            padding: 12px 0;
            text-align: center;
        }

        tbody tr:nth-child(even) {
            background: #fafafa;
        }

        
    </style>
</head>

<body>

    <div class="container mt-4">

        <h2 class="text-center mb-4">User List</h2>

        <table>
            <thead>
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th>Phone</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                <% for (let i=0; i < dataTable.length; i++) { %>
                    <tr>
                        <td>
                            <%= dataTable[i].firstName %>
                        </td>
                        <td>
                            <%= dataTable[i].lastName %>
                        </td>
                        <td>
                            <%= dataTable[i].email %>
                        </td>
                        <td>
                            <%= dataTable[i].address %>
                        </td>
                        <td>
                            <%= dataTable[i].phonenumber %>
                        </td>
                        <td>
                            <a href="/edit-crud?id=<%= dataTable[i].id %>" class="btn btn-warning btn-sm">Edit</a>
                            <a href="/delete-crud?id=<%= dataTable[i].id %>" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                    <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>